rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AI 난이도별 명예의 전당 랭킹 (Lv.1 ~ Lv.10)
    match /rankings/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.userId is string
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.aiLevel is int
        && request.resource.data.aiLevel >= 1
        && request.resource.data.aiLevel <= 10
        && request.resource.data.moves is int
        && request.resource.data.moves >= 2
        && request.resource.data.timeSec is int
        && request.resource.data.timeSec >= 1;
      allow delete: if true;
    }

    // 1:1 실시간 대국 방 및 착수 상태
    match /multiplayer_games/{gameId} {
      allow read: if true;
      allow create, update: if request.resource.data.fen is string
        && request.resource.data.status in ['waiting', 'playing', 'completed', 'abandoned'];
      allow delete: if true;
    }

    // 빠른 매칭 대기열
    match /matchmaking_queue/{queueId} {
      allow read, write: if true;
    }
  }
}
